// MODEL 600 // BROADCAST SUITE - Windows resources (configured by CMake).
// Icon + version information shown in the DLL's Properties > Details.
#include <winver.h>

1 ICON "@M600_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SEVENTHWELL"
            VALUE "FileDescription",  "MODEL 600 // BROADCAST SUITE - OBS plugin (@M600_EDITION_NAME@)"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "model600"
            VALUE "LegalCopyright",   "(c) @M600_YEAR@ SEVENTHWELL"
            VALUE "OriginalFilename", "model600.dll"
            VALUE "ProductName",      "MODEL 600"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
